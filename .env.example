# MustacharAI Environment Configuration
# Copy this file to .env and fill in the values.

# Application
APP_NAME=MustacharAI
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Groq (STT / LLM inference)
# GROQ_API_KEY=your-groq-api-key

# ChromaDB persistent storage
CHROMA_PERSIST_DIR=data/chroma_db

# Retrieval: minimum cosine similarity to keep a chunk (tuned on eval set)
# RETRIEVAL_THRESHOLD=0.84

# TTS: Edge-TTS voice for synthesized answers (French neural voice wins the
# ar-TN vs fr-FR A/B for naturalness on French answers)
# TTS_VOICE=fr-FR-HenriNeural
