# MustacharAI Environment Configuration
# Copy this file to .env and fill in the values.

# Application
APP_NAME=MustacharAI
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Groq (STT / LLM inference)
GROQ_API_KEY=your-groq-api-key
# GROQ_CHAT_MODEL=qwen/qwen3.8-27b      # tested: qwen/qwen3.8-27b, openai/gpt-oss-120b,
#                                       # openai/gpt-oss-20b, allam-2-7b (Arabic)
# GROQ_STT_MODEL=whisper-large-v3

# Google AI Studio (Gemini LLM provider — optional; must be a gemini-flash/pro
# OAuth "AQ." key seen by the x-goog-api-key header)
# GOOGLE_API_KEY=your-gemini-api-key-here

# Note: OpenRouter (your own key + model) is configured at runtime in the web
# UI (header button "OpenRouter"), persisted server-side, no env variable.

# ChromaDB persistent storage
CHROMA_PERSIST_DIR=data/chroma_db

# Retrieval: minimum cosine similarity to keep a chunk (tuned on eval set)
# RETRIEVAL_THRESHOLD=0.84

# TTS: Edge-TTS voice for synthesized answers (French neural voice wins the
# ar-TN vs fr-FR A/B for naturalness on French answers)
# TTS_VOICE=fr-FR-HenriNeural
